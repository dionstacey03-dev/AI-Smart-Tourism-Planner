# Firebase web app config (public client config; protect data with Security Rules + App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Browser key restricted by HTTP referrer and allowed Maps APIs
VITE_GOOGLE_MAPS_API_KEY=

# Server-only Gemini key. Do not prefix with VITE_.
GEMINI_API_KEY=
# Optional override; default is gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
